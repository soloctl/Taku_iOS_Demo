#建议使用github源，pod install前请检查终端代理网络是否通畅(可能需要通过代码给终端设置代理，否则终端不会走代理服务，具体请检查您的代理服务流量变化)，如遇失败可尝试使用pod install --repo-update命令
source 'https://github.com/CocoaPods/Specs.git'

platform :ios, '13.0'

# Adapter 6.5.90.2.1 pins SmartdigimktCNSDK = 6.5.90. After pod install, replace that
# official binary with the Beilehu custom 6.5.66 package for compatibility testing.
BEILEHU_SDM = '/Users/taku-0093/Documents/issue/20261028_贝乐虎_66定制包与聚合84兼容性测试/KuYingSDK'

post_install do |installer|
  require 'fileutils'
  dest = File.join(__dir__, 'Pods/SmartdigimktCNSDK/KuYingSDK')
  if File.directory?(BEILEHU_SDM) && File.directory?(File.dirname(dest))
    FileUtils.rm_rf(dest)
    FileUtils.cp_r(BEILEHU_SDM, dest)
    puts "[Beilehu] Replaced Pods/SmartdigimktCNSDK/KuYingSDK with custom 6.5.66"
  end
  installer.generated_projects.each do |project|
    project.targets.each do |target|
        target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
         end
    end
  end
end

target 'iOSDemo' do
  use_frameworks!
  
    # Taku SDK
    pod 'AnyThinkiOS','6.5.84'
    # AnyThink Kuying ADX adapter (pins official SmartdigimktCNSDK = 6.5.90)
    pod 'AnyThinkMediationAdxSmartdigimktCNAdapter','6.5.90.2.1'
    
    #Baidu--4.80 SDK,podfile文件顶部增加 source 'https://github.com/CocoaPods/Specs.git'
    pod 'AnyThinkMediationBaiduAdapter','10.022.0'
    pod 'AnyThinkMediationMSAdapter','2.7.13.0.0'
    pod 'AnyThinkMediationKuaiShouAdapter','4.12.20.1.0'
    pod 'AnyThinkMediationAdmobAdapter','12.14.0.0'
    pod 'AnyThinkMediationGDTAdapter','4.15.70.0'
 
    pod 'AnyThinkDebugUISDK','1.0.7'
 
  #第三方数据统计SDK
#  pod 'AppsFlyerFramework'
#  pod 'Adjust'
#  pod 'FirebaseAnalytics'
 
  # Demo UI依赖的第三库
  pod 'Masonry'
  pod 'SDWebImage'
  pod 'MJRefresh'
  pod 'SVProgressHUD'
   
end
